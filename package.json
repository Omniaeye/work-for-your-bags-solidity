{
  "name": "omnia-work-for-your-bags-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "forge build",
    "test:js": "node --test test/settlement/*.test.mjs",
    "test:solidity": "forge test",
    "test": "npm run test:js && npm run test:solidity",
    "prepare": "node scripts/prepare-round.mjs",
    "verify": "node scripts/verify-round.mjs",
    "check:repo": "node scripts/check-repository.mjs",
    "check": "npm run check:repo && forge fmt --check && npm test",
    "coverage": "forge coverage --report summary"
  },
  "overrides": {
    "@metamask/utils": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/merkle-tree": "1.0.8",
    "viem": "2.56.8"
  },
  "description": "Human-approved, prefunded ERC-20 reward rounds and deterministic off-chain settlement.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Omniaeye/work-for-your-bags-solidity.git"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
